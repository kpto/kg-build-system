# Everything under studio_test_project/studio_test_project/ is generated by KG Studio
# from .kg-studio/project.ir.json, and is committed deliberately: the generated project
# is what a reviewer reads, and a diff of it is a diff of the document.
#
# What is not committed is either run output or state the studio recomputes.
build/

# Derived from the document on every save; the document itself is the source of truth.
.kg-studio/anchors.json
.kg-studio/manifest.json

__pycache__/
*.py[oc]
