{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Reference Project",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/reference_project/build.py",
            "cwd": "${workspaceFolder}/reference_project",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Generate",
            "type": "debugpy",
            "request": "launch",
            "module": "kg_build_system.cli",
            "console": "integratedTerminal",
            "args": [
                "generate"
            ]
        }
    ]
}
